# ============================================================
#  SATARA POLYTECHNIC — BACKEND ENVIRONMENT VARIABLES
#  Copy this file to `.env` and fill in the real values.
#  The real .env is git-ignored — never commit it.
# ============================================================

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
# Environment: development | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# Set to 1 to enable Content-Security-Policy headers (0 to disable)
CSP_ENABLED=1

# ------------------------------------------------------------
# DATABASE (MongoDB Atlas)
# ------------------------------------------------------------
# Connection string from MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ------------------------------------------------------------
# ADMIN AUTH
# ------------------------------------------------------------
# Key required in the "x-admin-key" header for every write API call.
# The admin panel sends this automatically — use the same value there.
ADMIN_API_KEY=change-this-long-random-secret

# Multiple admins (comma-separated, pairs must align by position)
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com
ADMIN_PASSWORDS=strongpass1,strongpass2

# Single admin fallback (used only if the *_LISTS above are not set)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=changeme

# ------------------------------------------------------------
# FILE STORAGE (Supabase Storage)
# ------------------------------------------------------------
# PDFs and files are uploaded from the admin panel to Supabase Storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
SUPABASE_BUCKET=files

# ------------------------------------------------------------
# NOTES
# ------------------------------------------------------------
# - Cloudinary is NOT used by this project. Image uploads go directly
#   from the admin panel (frontend) to Cloudinary unsigned uploads.
#   See frontend/.env.example for those keys.
# - Email (Enquiry form) is sent client-side via EmailJS.
#   See frontend/.env.example for those keys.
