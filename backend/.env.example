# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sps?retryWrites=true&w=majority

# Frontend URL (for CORS)
FRONTEND_URL=https://satarapolytechnicsatara.com

# Admin authentication
# Single admin:
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your-secure-password

# Multi-admin (comma-separated):
# ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com
# ADMIN_PASSWORDS=pass1,pass2

# Admin API key (required for all write operations)
ADMIN_API_KEY=your-secure-admin-api-key
