# ============================================================
#  SATARA POLYTECHNIC — FRONTEND ENVIRONMENT VARIABLES (Vite)
#  Copy this file to `.env` and fill in the real values.
#  The real .env is git-ignored — never commit it.
# ============================================================

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
# Base URL of the backend API (no trailing slash).
# Local dev:  http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------
# IMAGE UPLOADS (Cloudinary — unsigned uploads from the browser)
# ------------------------------------------------------------
# Cloudinary Dashboard -> Settings -> Upload -> Add upload preset
# (set the preset's signing mode to "Unsigned")
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ------------------------------------------------------------
# PDF / FILE UPLOADS (Supabase Storage — used by PdfUpload)
# ------------------------------------------------------------
# Supabase Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ------------------------------------------------------------
# ENQUIRY EMAILS (EmailJS — sent client-side)
# ------------------------------------------------------------
# EmailJS Dashboard -> add the Service, two Templates, and API key.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_COLLEGE_TEMPLATE_ID=template_college
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_autoreply
VITE_EMAILJS_PUBLIC_KEY=your-public-key

# ------------------------------------------------------------
# NOTES
# ------------------------------------------------------------
# - Only VITE_* variables are exposed to the browser. Never put
#   service-role secrets or the admin password here.
