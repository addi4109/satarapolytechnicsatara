# ------------------------------------------------------------------
# SPS — environment variables (copy to .env and fill in your values)
# ------------------------------------------------------------------

# Port for the Express API server
PORT=5000

# --- MongoDB -------------------------------------------------------
# Get this from MongoDB Atlas (Database > Connect > Drivers) or a local mongod.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sps?retryWrites=true&w=majority
MONGODB_URI=

# --- Admin login ---------------------------------------------------
# Username shown on the /admin login page.
ADMIN_USERNAME=admin@gmail.com

# Provide EITHER a plain-text password ...
ADMIN_PASSWORD=admin123
# ... OR a bcrypt hash (generate one with: npm run hash-password).
# If ADMIN_PASSWORD_HASH is set it takes precedence.
#ADMIN_PASSWORD_HASH=

# --- JWT -----------------------------------------------------------
# Long random string used to sign admin session tokens.
JWT_SECRET=change-me-to-a-long-random-string

# --- Cloudinary ----------------------------------------------------
# Image uploads in the admin panel are stored on Cloudinary. Get these from
# https://console.cloudinary.com/settings/c-<cloud>/access
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Front-end -----------------------------------------------------
# Base URL of the API the browser calls (used by src/api.js).
# In production, set this to your deployed API host.
VITE_API_URL=http://localhost:5000

# Public site URL shown in the admin "Virtual View" (iframe preview).
VITE_PUBLIC_URL=http://localhost:5173
